# ==== Figma ====
# Figma Personal Access Token を設定してください
# 取得方法: https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
FIGMA_ACCESS_TOKEN=

# ==== GitHub ====
GITHUB_TOKEN=
GITHUB_MCP_URL=https://your-github-mcp.example.com/mcp/

# ==== Serena（ローカル/stdio） ====
SERENA_CMD=serena
SERENA_TRANSPORT=stdio

# ==== Context7（ローカル/stdio） ====
CONTEXT7_CMD=context7
CONTEXT7_TRANSPORT=stdio
CONTEXT7_API_KEY=

# ==== 共通補助 ====
# プロジェクトのルート（未設定なら '.'）
PROJECT_ROOT=.
